{
  "compilerOptions": {
    "target": "es2020",
    "module": "esnext",
    "jsx": "preserve",
    "esModuleInterop": true,
    "sourceMap": true,
    "lib": ["es2020", "dom", "dom.iterable"],
    "moduleResolution": "bundler",
    // TypeScript 7 defaults `strict` to true; this codebase predates that.
    // Kept off to preserve the pre-migration behaviour.
    "strict": false,
    "types": ["bun"],
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src/**/*", "vite.config.ts"],
  "exclude": ["**/node_modules", "**/dist"]
}
