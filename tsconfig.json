{
  "compilerOptions": {
    "target": "es2020",
    "module": "esnext",
    "jsx": "preserve",
    "esModuleInterop": true,
    "sourceMap": true,
    "lib": ["es2020", "dom", "dom.iterable"],
    "moduleResolution": "bundler",
    "strict": true,
    "types": ["bun"],
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src/**/*", "test/**/*", "vite.config.ts", "vitest.config.ts"],
  "exclude": ["**/node_modules", "**/dist"]
}
